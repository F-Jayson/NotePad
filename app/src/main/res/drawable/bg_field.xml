<?xml version="1.0" encoding="utf-8"?>
<!-- 对话框输入框：聚焦时描边变为强调色。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="150" android:exitFadeDuration="150">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/np_accent_soft" />
            <stroke android:width="1.5dp" android:color="@color/np_accent" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_field_normal" />
</selector>