<?xml version="1.0" encoding="utf-8"?>
<!-- 对话框窗口：四周留出透明边距的大圆角实色卡片。 -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16dp">
    <shape android:shape="rectangle">
        <corners android:radius="@dimen/np_dialog_radius" />
        <solid android:color="@color/np_surface" />
        <stroke android:width="1dp" android:color="@color/np_hairline" />
    </shape>
</inset>