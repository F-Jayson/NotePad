<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃卡片：半透明填充 + 亮色描边 + 顶部渐隐高光，叠在极光背景上形成通透质感。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/np_card_radius" />
            <solid android:color="@color/np_glass" />
            <stroke android:width="1dp" android:color="@color/np_glass_stroke" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/np_card_radius" />
            <gradient android:angle="270" android:startColor="@color/np_glass_sheen"
                android:centerColor="@color/np_glass_sheen_end" android:endColor="@color/np_glass_sheen_end" />
        </shape>
    </item>
</layer-list>