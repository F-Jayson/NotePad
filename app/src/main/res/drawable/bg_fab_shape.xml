<?xml version="1.0" encoding="utf-8"?>
<!-- 新建按钮：薄荷绿到天空蓝的渐变圆，带细亮边。使用单一 oval shape，使系统投射圆形阴影。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="315"
        android:startColor="@color/np_accent"
        android:endColor="@color/np_accent_end" />
    <stroke
        android:width="1.5dp"
        android:color="#66FFFFFF" />
</shape>
