<?xml version="1.0" encoding="utf-8"?>
<!-- API 19-20 次级玻璃胶囊按钮按下反馈。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/np_glass_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/np_glass_stroke" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_button_secondary_shape" />
</selector>
