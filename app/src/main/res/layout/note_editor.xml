<!-- 外层处理系统栏留白，避免窗口 Insets 覆盖正文的页边距。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/np_editor_background">

    <!-- 书签和标题固定在纸面上沿，只有正文区域滚动。 -->
    <LinearLayout
        android:id="@+id/editor_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_editor_page"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/np_page_margin"
            android:paddingEnd="@dimen/np_page_margin">

            <TextView
                android:id="@+id/editor_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="2"
                android:textColor="@color/np_editor_ink"
                android:textSize="25sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/editor_bookmark"
                android:layout_width="15dp"
                android:layout_height="27dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_np_bookmark" />
        </LinearLayout>

        <!-- 仍由原输入框管理文字、光标与滚动，纸面背景在外层更新。 -->
        <view
            class="com.example.android.notepad.NoteEditor$LinedEditText"
            android:id="@+id/note"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:paddingStart="@dimen/np_page_margin"
            android:paddingEnd="@dimen/np_page_margin"
            android:paddingTop="12dp"
            android:paddingBottom="14dp"
            android:scrollbars="vertical"
            android:fadingEdge="vertical"
            android:gravity="top|start"
            android:textSize="18sp"
            android:lineSpacingExtra="6sp"
            android:textColor="@color/np_editor_ink"
            android:inputType="textCapSentences|textMultiLine"
            android:imeOptions="flagNoExtractUi" />
    </LinearLayout>
</FrameLayout>
