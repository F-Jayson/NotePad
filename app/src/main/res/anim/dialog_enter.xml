<?xml version="1.0" encoding="utf-8"?>
<!-- 对话框从 92% 弹性放大并淡入。 -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <scale android:fromXScale="0.92" android:toXScale="1" android:fromYScale="0.92" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="280"
        android:interpolator="@android:anim/overshoot_interpolator" />
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="200"
        android:interpolator="@android:interpolator/decelerate_quad" />
</set>