<?xml version="1.0" encoding="utf-8"?>
<!-- 浅色模式配色：以薄荷绿和天空蓝为主色，背景偏冷白，卡片为半透明“玻璃”。
     深色模式在 values-night/colors.xml 中使用同名颜色覆盖，布局与图形只引用这些名字。 -->
<resources>
    <!-- 页面底色与极简点阵手账底纹颜色（去掉彩色渐变，保留克制纸感）。 -->
    <color name="np_background">#FFF4F6F6</color>
    <color name="np_pattern_dot">#1D16302C</color>
    <color name="np_pattern_cross">#2C14B89C</color>

    <!-- 文字层级：标题、正文摘要、时间与提示 -->
    <color name="np_text_primary">#FF16302C</color>
    <color name="np_text_secondary">#FF56706B</color>
    <color name="np_text_tertiary">#FF8EA19D</color>

    <!-- 强调色，用于新建按钮、主操作按钮、搜索聚焦描边和关键字高亮 -->
    <color name="np_accent">#FF14B89C</color>
    <color name="np_accent_soft">#2614B89C</color>
    <color name="np_on_accent">#FFFFFFFF</color>
    <color name="np_highlight">#4D14B89C</color>
    <color name="np_search_mark">#FF0E8F79</color>

    <!-- 卡片与输入框材质：提高不透明度使卡片像实体便签平置于点阵底纹之上，文字清晰锐利。 -->
    <color name="np_glass">#F2FFFFFF</color>
    <color name="np_glass_pressed">#FFFFFFFF</color>
    <color name="np_glass_stroke">#1C16302C</color>
    <color name="np_glass_sheen">#80FFFFFF</color>
    <color name="np_glass_sheen_end">#00FFFFFF</color>
    <color name="np_ripple">#180B3D36</color>
    <color name="np_field">#F2FFFFFF</color>

    <!-- 顶部栏在列表滚动后出现的遮罩与分隔线 -->
    <color name="np_header_scrim_top">#F5F3F8F7</color>
    <color name="np_header_scrim_bottom">#D9F3F8F7</color>
    <color name="np_hairline">#1A16302C</color>

    <!-- 弹窗、菜单的实色表面与时间胶囊底色 -->
    <color name="np_surface">#FFFDFEFE</color>
    <color name="np_chip">#0F16302C</color>

    <!-- 浅色编辑器采用雾蓝底色，暖纸留一点米色便于辨别。 -->
    <color name="np_editor_background">#FFF2F7F8</color>
    <color name="np_editor_ink">#FF182F3C</color>
    <color name="np_paper_white">#FFFFFFFF</color>
    <color name="np_paper_warm">#FFFFFAF1</color>
    <color name="np_paper_warm_ink">#FF45392E</color>
    <color name="np_paper_warm_line">#FFE9DDCB</color>
    <color name="np_editor_line">#FFD9E4E7</color>
    <color name="np_paper_white_tab">#FF90C8C2</color>
    <color name="np_paper_warm_tab">#FFD8AE6B</color>

    <!-- 应用自适应图标底色，与上传图标的薄荷绿底面一致，用于无黑边/白边铺满裁切区域。 -->
    <color name="ic_launcher_background">#FFCFF4F3</color>

    <!-- 低版本系统栏图标无法变深时使用的半透明遮罩 -->
    <color name="np_bar_scrim">#33000000</color>

    <!-- 卡片的五种点缀色，按笔记 ID 轮换 -->
    <color name="np_tag_mint">#FF2EC4A0</color>
    <color name="np_tag_sky">#FF4AA3F5</color>
    <color name="np_tag_lavender">#FF9A8CF5</color>
    <color name="np_tag_peach">#FFFF9C78</color>
    <color name="np_tag_lemon">#FFF2BE3A</color>
    <array name="np_tags">
        <item>@color/np_tag_mint</item>
        <item>@color/np_tag_sky</item>
        <item>@color/np_tag_lavender</item>
        <item>@color/np_tag_peach</item>
        <item>@color/np_tag_lemon</item>
    </array>
</resources>
