    <style name="Platform.NotePad" parent="android:Theme.Material.Light.NoActionBar" />
    <style name="Platform.Editor" parent="android:Theme.Material.Light" />
    <style name="Platform.Dialog" parent="android:Theme.Material.Light.Dialog.NoActionBar" />
    <style name="Platform.Alert" parent="android:Theme.Material.Light.Dialog.Alert" />
    <style name="Platform.ActionBar" parent="android:Widget.Material.Light.ActionBar.Solid" />
    <style name="Platform.PopupMenu" parent="android:Widget.Material.Light.PopupMenu" />
</resources>
